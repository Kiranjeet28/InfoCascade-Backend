# ========================================
# Environment Configuration Example
# Copy this to .env and fill in your values
# ========================================

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=5000
REQUEST_TIMEOUT=30000

# ========================================
# SECURITY & RATE LIMITING
# ========================================

# Rate Limiting (requests per hour per IP)
API_RATE_LIMIT=30

# Global rate limit settings
# Window: 15 minutes = 15 * 60 * 1000 ms
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Payload size limits (prevents large payload attacks)
PAYLOAD_SIZE_LIMIT=10kb

# Request timeout (prevents slowloris attacks)
REQUEST_TIMEOUT_MS=30000

# CORS Configuration
# For development: http://localhost:3000
# For production: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# Session/JWT Secret (use a strong random string)
SESSION_SECRET=your-secret-key-change-this-in-production-to-a-random-string
JWT_SECRET=change-this-in-production

# ========================================
# DATABASE
# ========================================

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/infocascade

# ========================================
# AI ASSISTANT CONFIGURATION
# ========================================

# Gemini API Key (get from Google AI Studio)
GEMINI_API_KEY=AIzaSyDtAEFETgWT0LESoKDHF3ofdOdNxbEk50U

# ========================================
# EMAIL CONFIGURATION
# ========================================

# Email Service (nodemailer or resend)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Or use Resend
RESEND_API_KEY=your-resend-api-key

# Email settings
EMAIL_FROM=noreply@infocascade.com
EMAIL_SUPPORT=support@infocascade.com

# ========================================
# OTP SETTINGS
# ========================================

# OTP Configuration
OTP_EXPIRY=10 minutes
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# Redis (optional, for OTP store)
REDIS_URL=redis://localhost:6379

# ========================================
# LOGGING
# ========================================

# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# Morgan logging format
# Options: combined, common, dev, short, tiny
MORGAN_FORMAT=dev

# ========================================
# PRODUCTION SETTINGS
# ========================================

# For production, ensure:
# - NODE_ENV=production
# - Use strong random values for JWT_SECRET (minimum 32 chars)
# - Use appropriate CORS_ORIGIN for your domain
# - Set API_RATE_LIMIT based on expected traffic

OPENROUTER_API_KEY=your-openrouter-api-key